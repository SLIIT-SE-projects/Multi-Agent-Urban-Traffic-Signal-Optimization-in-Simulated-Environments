<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle Types -->
    <vType id="car"       accel="2.6" decel="4.5" sigma="0.5" length="5"  maxSpeed="50" color="1,1,0"/>
    <vType id="bus"       accel="1.2" decel="4.0" sigma="0.3" length="12" maxSpeed="40" vClass="bus"       color="0,1,1"/>
    <vType id="truck"     accel="1.8" decel="4.0" sigma="0.4" length="8"  maxSpeed="40" color="0.5,0.5,0.5"/>
    <vType id="emergency" accel="3.5" decel="5.5" sigma="0.2" length="6"  maxSpeed="60" vClass="emergency" color="1,0,0"/>

    <!-- HORIZONTAL ROUTES - West to East -->
    <route id="route_WE_0" edges="W0_J00 J00_J10 J10_E0"/>
    <route id="route_WE_1" edges="W1_J01 J01_J11 J11_E1"/>

    <!-- HORIZONTAL ROUTES - East to West -->
    <route id="route_EW_0" edges="E0_J10 J10_J00 J00_W0"/>
    <route id="route_EW_1" edges="E1_J11 J11_J01 J01_W1"/>

    <!-- VERTICAL ROUTES - South to North -->
    <route id="route_SN_0" edges="S0_J00 J00_J01 J01_N0"/>
    <route id="route_SN_1" edges="S1_J10 J10_J11 J11_N1"/>

    <!-- VERTICAL ROUTES - North to South -->
    <route id="route_NS_0" edges="N0_J01 J01_J00 J00_S0"/>
    <route id="route_NS_1" edges="N1_J11 J11_J10 J10_S1"/>

    <!-- DIAGONAL ROUTES -->
    <route id="route_diag_SW_NE" edges="W0_J00 J00_J01 J01_J11 J11_E1"/>
    <route id="route_diag_SE_NW" edges="S1_J10 J10_J00 J00_J01 J01_W1"/>
    <route id="route_diag_NW_SE" edges="N0_J01 J01_J00 J00_J10 J10_S1"/>
    <route id="route_diag_NE_SW" edges="E1_J11 J11_J01 J01_J00 J00_W0"/>

    <!-- TRAFFIC FLOWS -->
    <!-- Horizontal flows -->
    <flow id="flow_WE_0" type="car" route="route_WE_0" begin="0" end="3600" vehsPerHour="400" departLane="best"/>
    <flow id="flow_WE_1" type="car" route="route_WE_1" begin="0" end="3600" vehsPerHour="500" departLane="best"/>
    <flow id="flow_EW_0" type="car" route="route_EW_0" begin="0" end="3600" vehsPerHour="380" departLane="best"/>
    <flow id="flow_EW_1" type="car" route="route_EW_1" begin="0" end="3600" vehsPerHour="480" departLane="best"/>

    <!-- Vertical flows -->
    <flow id="flow_SN_0" type="car" route="route_SN_0" begin="0" end="3600" vehsPerHour="350" departLane="best"/>
    <flow id="flow_SN_1" type="car" route="route_SN_1" begin="0" end="3600" vehsPerHour="400" departLane="best"/>
    <flow id="flow_NS_0" type="car" route="route_NS_0" begin="0" end="3600" vehsPerHour="320" departLane="best"/>
    <flow id="flow_NS_1" type="car" route="route_NS_1" begin="0" end="3600" vehsPerHour="370" departLane="best"/>

    <!-- Diagonal flows -->
    <flow id="flow_diag_1" type="car" route="route_diag_SW_NE" begin="0" end="3600" vehsPerHour="150" departLane="best"/>
    <flow id="flow_diag_2" type="car" route="route_diag_SE_NW" begin="0" end="3600" vehsPerHour="130" departLane="best"/>
    <flow id="flow_diag_3" type="car" route="route_diag_NW_SE" begin="0" end="3600" vehsPerHour="140" departLane="best"/>
    <flow id="flow_diag_4" type="car" route="route_diag_NE_SW" begin="0" end="3600" vehsPerHour="120" departLane="best"/>

    <!-- Bus routes -->
    <flow id="flow_bus_WE" type="bus" route="route_WE_1" begin="0" end="3600" vehsPerHour="40" departLane="best"/>
    <flow id="flow_bus_EW" type="bus" route="route_EW_1" begin="0" end="3600" vehsPerHour="40" departLane="best"/>
    <flow id="flow_bus_SN" type="bus" route="route_SN_1" begin="0" end="3600" vehsPerHour="30" departLane="best"/>
    <flow id="flow_bus_NS" type="bus" route="route_NS_1" begin="0" end="3600" vehsPerHour="30" departLane="best"/>

    <!-- Trucks -->
    <flow id="flow_truck_WE" type="truck" route="route_WE_0" begin="0" end="3600" vehsPerHour="60" departLane="best"/>
    <flow id="flow_truck_EW" type="truck" route="route_EW_0" begin="0" end="3600" vehsPerHour="60" departLane="best"/>

    <!-- Emergency vehicles -->
    <vehicle id="ambulance_1" type="emergency" route="route_WE_1" depart="300"  color="1,0,0"/>
    <vehicle id="fire_truck_1" type="emergency" route="route_SN_1" depart="900"  color="1,0,0"/>
    <vehicle id="police_1"    type="emergency" route="route_EW_1" depart="1500" color="0,0,1"/>
</routes>
