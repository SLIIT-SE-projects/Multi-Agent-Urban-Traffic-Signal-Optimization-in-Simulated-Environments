# EVPS Service environment variables.
# Copy to `.env` and adjust to your setup.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8004
DEBUG=0

# ── Models ──────────────────────────────────────────────────────────────
# Directory containing models/saved/{eta_predictor.h5, outcome_safety_classifier.pkl}
# and data/scalers/{eta_scaler.pkl, eta_target_scaler.pkl}
EVPS_MODELS_DIR=/workspace/services/emergency_vehicle_preemption

# ── Inference behavior ──────────────────────────────────────────────────
SEQUENCE_LENGTH=10
ETA_SMOOTHING_ALPHA=0.3
MAX_INFERENCE_MS=500
