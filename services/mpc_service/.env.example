# MPC Service environment variables.
# Copy to `.env` and adjust to your setup.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8003
DEBUG=0

# ── MPC LSTM weights ────────────────────────────────────────────────────
# Directory containing model.pth and lane_ids.json (and optionally
# model_<scenario>.pth, lane_ids_<scenario>.json for non-default scenarios).
WEIGHTS_DIR=/workspace/services/mpc_traffic_control/data

# ── Inference ───────────────────────────────────────────────────────────
MAX_INFERENCE_MS=2000
DECISION_INTERVAL_STEPS=15

# ── Scenarios ───────────────────────────────────────────────────────────
# Used as a fallback when /reset doesn't pass an explicit net.xml path.
SCENARIOS_DIR=/workspace/simulation_and_control_panel/scenarios
