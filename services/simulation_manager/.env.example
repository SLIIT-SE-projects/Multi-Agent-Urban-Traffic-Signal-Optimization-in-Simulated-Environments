# Simulation Manager environment variables.
# Copy to `.env` and adjust to your setup.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=1

# ── SUMO connection ─────────────────────────────────────────────────────
# 'local'  — Manager spawns sumo / sumo-gui itself (current default for non-Docker dev)
# 'remote' — SUMO is already running on the host; Manager connects via TCP (Docker default)
SUMO_MODE=local
SUMO_HOST=localhost
SUMO_PORT=8813
USE_GUI=1

# ── Simulation behavior ─────────────────────────────────────────────────
STEP_LENGTH=1.0
STEP_DELAY=0.1
AUTO_START_STEPPING=1

# ── Scenarios ───────────────────────────────────────────────────────────
# By default this resolves to <repo>/simulation_and_control_panel/scenarios.
# Inside Docker, mount the host scenarios folder to /app/scenarios and
# set SCENARIOS_DIR=/app/scenarios.
# SCENARIOS_DIR=/app/scenarios
DEFAULT_SCENARIO=grid3x3
# DEFAULT_CONFIG_FILE=  (computed from SCENARIOS_DIR + DEFAULT_SCENARIO if unset)

# ── Model Routing (Phase 3+) ────────────────────────────────────────────
# When set, the named model is routed via HTTP to a dedicated service.
# Without it, the Manager uses its in-process adapter (Phase 2 fallback).
# MODEL_GNN_URL=http://gnn_service:8002
# MODEL_MPC_URL=http://mpc_service:8003
# MODEL_TIMEOUT_MS=2000
# MODEL_RESET_TIMEOUT_MS=30000
# MODEL_GNN_AUTH_TOKEN=          # Bearer token for external GNN service
# MODEL_MPC_AUTH_TOKEN=          # Bearer token for external MPC service

# ── EVPS Routing (Phase 5+) ────────────────────────────────────────────
# When set, EVPS calls go to the dedicated evps_service.
# EVPS_URL=http://evps_service:8004
# EVPS_TIMEOUT_MS=2000

# ── Dashboard API for registry lookup (Phase 6+) ───────────────────────
# Lets the Manager resolve external-researcher model names registered at
# runtime via POST /api/models/register on the Dashboard API.
# DASHBOARD_API_URL=http://dashboard_api:8000

# ── Project root (rarely overridden) ────────────────────────────────────
# Resolves automatically to two levels up from config.py. Override only if
# you've reorganized the repo or are mounting a non-standard layout.
# PROJECT_ROOT=/app/project_root
