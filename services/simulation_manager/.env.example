# Simulation Manager environment variables.
# Copy to `.env` and adjust to your setup.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=1

# ── SUMO connection ─────────────────────────────────────────────────────
# 'local'  — Manager spawns sumo / sumo-gui itself (current default for non-Docker dev)
# 'remote' — SUMO is already running on the host; Manager connects via TCP (Docker default)
SUMO_MODE=local
SUMO_HOST=localhost
SUMO_PORT=8813
USE_GUI=1

# ── Simulation behavior ─────────────────────────────────────────────────
STEP_LENGTH=1.0
STEP_DELAY=0.1
AUTO_START_STEPPING=1

# ── Scenarios ───────────────────────────────────────────────────────────
# By default this resolves to <repo>/simulation_and_control_panel/scenarios.
# Inside Docker, mount the host scenarios folder to /app/scenarios and
# set SCENARIOS_DIR=/app/scenarios.
# SCENARIOS_DIR=/app/scenarios
DEFAULT_SCENARIO=grid3x3
# DEFAULT_CONFIG_FILE=  (computed from SCENARIOS_DIR + DEFAULT_SCENARIO if unset)

# ── Project root (rarely overridden) ────────────────────────────────────
# Resolves automatically to two levels up from config.py. Override only if
# you've reorganized the repo or are mounting a non-standard layout.
# PROJECT_ROOT=/app/project_root
