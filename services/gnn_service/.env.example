# GNN Service environment variables.
# Copy to `.env` and adjust to your setup.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8002
DEBUG=0

# ── Model ───────────────────────────────────────────────────────────────
# Path to the trained MARL model weights file (.pth).
MODEL_WEIGHTS_PATH=/workspace/model_weights/final_marl_model_best.pth

# ── Inference ───────────────────────────────────────────────────────────
MAX_INFERENCE_MS=2000
DECISION_INTERVAL_STEPS=15
MC_DROPOUT_SAMPLES=20

# ── Scenarios ───────────────────────────────────────────────────────────
# Used as a fallback when /reset doesn't pass an explicit net.xml path.
SCENARIOS_DIR=/workspace/simulation_and_control_panel/scenarios
