# Dashboard API Gateway environment variables.
# Copy to `.env` and adjust to your setup.

# ── Server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Redis (telemetry pub/sub + model registry) ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Browser-facing CORS ─────────────────────────────────────────────────
DASHBOARD_CORS_ORIGIN=http://localhost:5173

# ── Upstream services (proxied) ─────────────────────────────────────────
MANAGER_API=http://simulation_manager:5000/api
MANAGER_WS=http://simulation_manager:5000
